{
  "name": "api-client-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Typed TypeScript client for the Platform Core API, generated from openapi/openapi.json",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript ../../openapi/openapi.json -o src/generated/schema.ts",
    "check:generated": "openapi-typescript ../../openapi/openapi.json -o src/generated/schema.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run check:generated && vitest run --typecheck"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
