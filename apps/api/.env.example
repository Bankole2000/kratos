# Configuration for apps/api. Copy to apps/api/.env for local development; `cargo run -p api`
# loads it. Real environment variables take precedence over the file. In staging and
# production, values come from the secret store named in docs/DEPLOYMENT.md.

# Address and port to listen on. Use 0.0.0.0 inside a container.
API_HOST=127.0.0.1
API_PORT=18080

# Log filter (tracing EnvFilter syntax), e.g. info, debug, or api=debug,info
RUST_LOG=info

# Postgres connection string. Required. Local: the docker compose database (no password,
# trust auth, local only). Staging and production: from the secret store; never logged.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/platform_core

# Origins allowed to call the api from a browser or WebView (CORS), comma-separated. Each is
# exactly scheme://host or scheme://host:port, as the browser sends it in the Origin header:
# no path, no trailing slash, never `*`. An invalid entry, or an empty list, stops the api at
# startup. The default covers the web dashboard dev server (port 13000), the Tauri dev server
# (port 1420) and the Tauri production app (tauri://localhost on macOS and Linux,
# http(s)://tauri.localhost on Windows).
API_CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000,http://localhost:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
