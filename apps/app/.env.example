# Public build-time configuration for apps/app. Vite compiles every VITE_* value into the app,
# so it ships to users: never put a secret here (docs/platform-core.md, principle 10).
# Copy to .env (gitignored) to change it locally.

# Root URL of the api, without a trailing slash. The default is the local api.
# If you change it, also add the new origin to connect-src in src-tauri/tauri.conf.json.
VITE_API_BASE_URL=http://127.0.0.1:18080
