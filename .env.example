# Repository-wide tooling only (scripts, local infrastructure such as docker compose).
# Each app has its own apps/<app>/.env.example. Never commit real secrets.
#
# Document every variable in this format:
#   # <What it is>. Required|Optional (default: <value>). Source: <where to get it>.
#   NAME=<safe example value>

# Runtime environment. Required. One of: development, test, production.
APP_ENV=development

# Local Postgres started by docker-compose.yml. Required for building apps/api with live
# query checks (sqlx macros), for `sqlx migrate run`, `cargo sqlx prepare` and
# `cargo test -p api`. No password: the local database uses trust auth (local only).
# Set SQLX_OFFLINE=true to build from the committed .sqlx/ data without a database.
# Uses 127.0.0.1, not localhost: the port is published on IPv4 only, and on Windows
# trying ::1 first adds about two seconds to every new connection.
# Source: docker-compose.yml.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/platform_core
