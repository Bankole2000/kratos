# Rename to dependabot.yml in M0 (TASK-010), once the workspaces exist.
# One root Cargo workspace and one root pnpm workspace, so both use directory "/".
version: 2
updates:
  - package-ecosystem: github-actions
    directory: /
    schedule:
      interval: weekly

  # Rust: apps/api, packages/types, apps/app/src-tauri and sdks/rust (Cargo workspace)
  - package-ecosystem: cargo
    directory: /
    schedule:
      interval: weekly
    groups:
      minor-and-patch:
        update-types: [minor, patch]

  # JavaScript/TypeScript: apps/web, apps/app, packages/ui, packages/api-client-ts, sdks/ts
  - package-ecosystem: npm
    directory: /
    schedule:
      interval: weekly
    groups:
      minor-and-patch:
        update-types: [minor, patch]

  # Dart SDK (from M4). Uncomment when sdks/dart exists.
  # - package-ecosystem: pub
  #   directory: /sdks/dart
  #   schedule:
  #     interval: weekly
