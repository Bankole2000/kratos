# Rename to release.yml before the first release (M5 for api, web and app; M3 for
# sdk-ts). Job names and environment names use the release names below.
#
# How it works:
# - A human pushes a tag `<name>-vX.Y.Z` (see docs/DEPLOYMENT.md, Release checklist):
#   api, web or app for apps/<name>; sdk-ts, sdk-dart or sdk-rust for sdks/<language>.
#   "resolve" reads the name from the tag; only that name's jobs run.
# - Each job uses a GitHub deployment environment (Settings → Environments), e.g.
#   "release-api". Put deploy credentials, signing material and registry tokens in
#   the environment's secrets, and set "Required reviewers" to the release owner
#   (@Bankole2000), so the job waits for approval and secrets never reach PR builds
#   or agents.
# - The app (Tauri) is built once per platform. macOS runners are used only for the
#   macOS and iOS builds, because they are billed at a much higher rate than Linux.
#
# Check for newer action major versions, and consider pinning actions to a full
# commit SHA.
name: Release

on:
  push:
    tags: ['*-v[0-9]*.[0-9]*.[0-9]*']

permissions:
  contents: read

concurrency:
  group: release-${{ github.ref_name }}
  cancel-in-progress: false   # never cancel a release half-way

jobs:
  resolve:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      name: ${{ steps.parse.outputs.name }}
      version: ${{ steps.parse.outputs.version }}
    steps:
      - uses: actions/checkout@v7
      - id: parse
        env:
          TAG: ${{ github.ref_name }}   # passed via env, never interpolated into the script
        run: |
          if [[ ! "$TAG" =~ ^([a-z][a-z0-9-]*)-v([0-9]+\.[0-9]+\.[0-9]+.*)$ ]]; then
            echo "Tag '$TAG' is not of the form <name>-vX.Y.Z"; exit 1
          fi
          name="${BASH_REMATCH[1]}"; version="${BASH_REMATCH[2]}"
          case "$name" in
            sdk-*) dir="sdks/${name#sdk-}" ;;
            *)     dir="apps/$name" ;;
          esac
          if [ ! -d "$dir" ]; then echo "No folder $dir for tag $TAG"; exit 1; fi
          if ! grep -q "## \[$version\]" "$dir/CHANGELOG.md"; then
            echo "$dir/CHANGELOG.md has no entry for $version"; exit 1
          fi
          echo "name=$name" >> "$GITHUB_OUTPUT"
          echo "version=$version" >> "$GITHUB_OUTPUT"

  # ── api: build, migrate, deploy (target in D1) ───────────────
  api:
    needs: resolve
    if: needs.resolve.outputs.name == 'api'
    runs-on: ubuntu-latest
    environment: release-api
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Build the api binary or image, run sqlx migrate (backward compatible), deploy, smoke test /health."
          exit 1

  # ── web: build and deploy (target in D1) ─────────────────────
  web:
    needs: resolve
    if: needs.resolve.outputs.name == 'web'
    runs-on: ubuntu-latest
    environment: release-web
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Build the Nuxt app, deploy it to production, smoke test sign-in."
          exit 1

  # ── app: desktop, one build per operating system ─────────────
  app-desktop:
    needs: resolve
    if: needs.resolve.outputs.name == 'app'
    strategy:
      fail-fast: true
      matrix:
        os: [windows-latest, macos-latest, ubuntu-latest]
    runs-on: ${{ matrix.os }}
    environment: release-app
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v7
      # tauri-apps/tauri-action can build, sign and attach installers to a draft GitHub release.
      - name: Fail until configured
        run: |
          echo "Build the Tauri app for ${{ matrix.os }}, sign it (Windows code signing / macOS Developer ID),"
          echo "notarize it on macOS, sign the updater artifacts, and publish as a draft for the release owner."
          exit 1

  # ── app: mobile, one job per platform ────────────────────────
  app-android:
    needs: resolve
    if: needs.resolve.outputs.name == 'app'
    runs-on: ubuntu-latest
    environment: release-app
    timeout-minutes: 45
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Run 'tauri android build' with the upload keystore from environment secrets; upload the bundle to the internal testing track."
          exit 1

  app-ios:
    needs: resolve
    if: needs.resolve.outputs.name == 'app'
    runs-on: macos-latest   # required for iOS; higher cost
    environment: release-app
    timeout-minutes: 60
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Run 'tauri ios build' with certificates from environment secrets; upload to TestFlight."
          exit 1

  # ── SDKs: publish to package registries ──────────────────────
  sdk-ts:
    needs: resolve
    if: needs.resolve.outputs.name == 'sdk-ts'
    runs-on: ubuntu-latest
    environment: release-sdk-ts
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write   # npm provenance / trusted publishing
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Build sdks/ts, run the conformance suite, publish to npm (name in D6)."
          exit 1

  sdk-dart:
    needs: resolve
    if: needs.resolve.outputs.name == 'sdk-dart'
    runs-on: ubuntu-latest
    environment: release-sdk-dart
    timeout-minutes: 15
    permissions:
      contents: read
      id-token: write   # pub.dev automated publishing via OIDC
    steps:
      - uses: actions/checkout@v7
      - name: Fail until configured
        run: |
          echo "Run the conformance suite in sdks/dart, then dart pub publish (name in D6)."
          exit 1
