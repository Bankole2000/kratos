# Rename to ci.yml in M0 (TASK-010), once the commands below exist. They match the
# README Commands table; keep the two in sync. Add a job when an SDK or apps/mcp is
# created.
#
# How it works:
# - "changes" works out which parts a PR touches. Shared Rust code (packages/types,
#   Cargo files) runs api and app; shared JS code (packages/, pnpm files) runs web
#   and app; the OpenAPI spec runs everything that consumes it.
# - Each job runs only when its part changed (it shows as skipped otherwise).
# - "ci-ok" runs last and fails if any job failed or was cancelled. Make "ci-ok"
#   the ONLY required status check in branch protection: requiring the other jobs
#   directly would block PRs whose jobs were skipped.
#
# Keeping CI fast and affordable:
# - Lint, typecheck, unit and integration tests and quick builds only, on
#   ubuntu-latest. Signed Tauri builds for Windows, macOS, Android and iOS run only
#   in release.yml (macOS runners are billed at a much higher rate).
#
# Check for newer action major versions, and consider pinning actions to a full
# commit SHA (especially third-party ones such as dorny/paths-filter).
name: CI

on:
  pull_request:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  changes:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
    outputs:
      api: ${{ steps.filter.outputs.api }}
      web: ${{ steps.filter.outputs.web }}
      app: ${{ steps.filter.outputs.app }}
    steps:
      - uses: actions/checkout@v7
      - id: filter
        uses: dorny/paths-filter@v4
        with:
          filters: |
            rust: &rust
              - 'Cargo.toml'
              - 'Cargo.lock'
              - 'rust-toolchain.toml'
              - 'packages/types/**'
              - '.github/workflows/ci.yml'
            js: &js
              - 'package.json'
              - 'pnpm-lock.yaml'
              - 'pnpm-workspace.yaml'
              - '.nvmrc'
              - 'packages/ui/**'
              - 'packages/api-client-ts/**'
              - 'openapi/**'
              - '.github/workflows/ci.yml'
            api:
              - *rust
              - 'apps/api/**'
              - '.sqlx/**'
              - 'openapi/**'
            web:
              - *js
              - 'apps/web/**'
            app:
              - *rust
              - *js
              - 'apps/app/**'

  placeholders:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7
      - name: Check for unfilled template placeholders
        run: bash scripts/check-placeholders.sh

  api:
    needs: changes
    if: needs.changes.outputs.api == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 20
    services:
      postgres:
        image: postgres:17
        env:
          # Throwaway database that exists only for this job: no password at all, so
          # nothing secret-looking is committed. Never use trust auth outside CI.
          POSTGRES_HOST_AUTH_METHOD: trust
        ports: ['5432:5432']
        options: --health-cmd pg_isready --health-interval 5s --health-retries 10
    env:
      DATABASE_URL: postgres://postgres@localhost:5432/postgres
      SQLX_OFFLINE: 'true'
    steps:
      - uses: actions/checkout@v7
      # Rust example — adjust once TASK-001 to TASK-004 exist:
      # - uses: dtolnay/rust-toolchain@stable
      #   with:
      #     components: rustfmt, clippy
      # - uses: Swatinem/rust-cache@v2
      # - run: cargo fmt --check
      # - run: cargo clippy -p api -- -D warnings
      # - run: cargo test -p api
      # Generated files must be up to date (TESTING.md, contract tests):
      # - run: cargo install sqlx-cli --no-default-features --features postgres
      # - run: cargo sqlx prepare --workspace --check
      # - run: cargo run -p api -- openapi > openapi/openapi.json && git diff --exit-code openapi/
      - name: Fail until configured
        run: |
          echo "Replace with the api's format, lint, test and generated-file checks."
          exit 1

  web:
    needs: changes
    if: needs.changes.outputs.web == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7
      # Node.js example — adjust once TASK-006 to TASK-008 exist:
      # - uses: pnpm/action-setup@v4
      # - uses: actions/setup-node@v7
      #   with:
      #     node-version-file: .nvmrc
      #     cache: pnpm
      # - run: pnpm install --frozen-lockfile
      # - run: pnpm --filter api-client-ts generate && git diff --exit-code packages/api-client-ts
      # - run: pnpm --filter ui --filter web lint
      # - run: pnpm --filter ui --filter web typecheck
      # - run: pnpm --filter ui --filter web test
      # - run: pnpm --filter web build
      # E2E (Playwright against a running api) is added with the first M1 journey.
      - name: Fail until configured
        run: |
          echo "Replace with web and packages/ui install, lint, typecheck, test and build commands."
          exit 1

  app:
    needs: changes
    if: needs.changes.outputs.app == 'true' || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest   # Keep on Linux; signed builds for every platform run in release.yml
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v7
      # Tauri example — adjust once TASK-009 exists. Lint, typecheck, unit tests and a
      # compile check of src-tauri on Linux only:
      # - run: sudo apt-get update && sudo apt-get install -y libwebkit2gtk-4.1-dev libappindicator3-dev librsvg2-dev patchelf
      # - uses: dtolnay/rust-toolchain@stable
      # - uses: Swatinem/rust-cache@v2
      # - uses: pnpm/action-setup@v4
      # - uses: actions/setup-node@v7
      #   with:
      #     node-version-file: .nvmrc
      #     cache: pnpm
      # - run: pnpm install --frozen-lockfile
      # - run: pnpm --filter app lint
      # - run: pnpm --filter app typecheck
      # - run: pnpm --filter app test
      # - run: cargo clippy --manifest-path apps/app/src-tauri/Cargo.toml -- -D warnings
      - name: Fail until configured
        run: |
          echo "Replace with the app's install, lint, typecheck, test and src-tauri checks."
          exit 1

  ci-ok:
    if: always()
    needs: [changes, placeholders, api, web, app]
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Fail if any job failed or was cancelled
        run: |
          if ${{ contains(needs.*.result, 'failure') || contains(needs.*.result, 'cancelled') }}; then
            echo "One or more jobs failed or were cancelled."
            exit 1
          fi
          echo "All jobs passed or were skipped."
