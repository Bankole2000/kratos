# Same Postgres instance the Rust read server reads from.
# The management server connects with its own independent connection string — no shared connection pool, no sync pipeline.
DATABASE_URL="postgresql://user:password@localhost:5432/common_resources?schema=public"

PORT=3000

# RS256 keypair for signing/verifying identity JWTs (Core Platform).
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Store as a single line with literal \n for newlines. JWT_PUBLIC_KEY is safe
# to share with consuming projects (e.g. Portfolio Manager) for local,
# network-free token verification — JWT_PRIVATE_KEY must never leave this service.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Comma-separated allow-list of origins permitted to call the identity API
# with credentials (cookies) — must include every consuming project's
# frontend origin.
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Messaging — email verification / password reset delivery (Resend).
# https://resend.com/docs/api-reference/emails
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# Messaging — push notifications (Firebase Cloud Messaging), Phase 3.
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. FCM_SERVICE_ACCOUNT_JSON is the full downloaded JSON,
# minified to one line.
FCM_PROJECT_ID=""
FCM_SERVICE_ACCOUNT_JSON=""
